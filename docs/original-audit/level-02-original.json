  "events": {
    "battle_music_id_original": 16,
    "remaster_battle_track": "assets/audio/hulao-lubu-theme.mp3",
    "prebattle_march_dialogue": [
      {
        "offset": 4219,
        "speaker_id": 1,
        "text": "敵人好像逃到了前面的虎牢關．大哥，該怎麼辦？"
      },
      {
        "offset": 4281,
        "speaker_id": 2,
        "text": "說什麼呀？現在當然是乘勝追擊了，我去！"
      },
      {
        "offset": 4370,
        "speaker_id": 1,
        "text": "唉！追上去了，還是那麼魯莽．"
      },
      {
        "offset": 4403,
        "speaker_id": 12,
        "text": "話不要這麼說，我軍士氣也鼓舞起來了嘛．"
      },
      {
        "offset": 4446,
        "speaker_id": 15,
        "text": "現在應該乘勢攻下虎牢關．"
      },
      {
        "offset": 4475,
        "speaker_id": 0,
        "text": "沒辦法，好！跟上張飛！進軍虎牢關！"
      }
    ],
    "objective_text": "一、呂布敗退．",
    "opening_dialogue": [
      {
        "offset": 4531,
        "speaker_id": 4,
        "text": "什麼？聯軍攻來了，還殺了華雄？好厲害，不過，他們的好運也就到此為止了．"
      },
      {
        "offset": 4604,
        "speaker_id": 80,
        "text": "呂布將軍，現在讓他們知道一下我軍的厲害．"
      },
      {
        "offset": 4647,
        "speaker_id": 4,
        "text": "好，全軍出擊！聯軍，好好看看我的厲害．"
      },
      {
        "offset": 4688,
        "speaker_id": 2,
        "text": "主將何在？不能只讓關羽逞雄風，我也要出風頭．"
      },
      {
        "offset": 4735,
        "speaker_id": 1,
        "text": "這裡好像是呂布把守．"
      },
      {
        "offset": 4758,
        "speaker_id": 0,
        "text": "是呂布，恐怕沒有比他更可怕的敵人了．"
      },
      {
        "offset": 4797,
        "speaker_id": 1,
        "text": "呂布座下赤兔馬，據說日行千里．"
      },
      {
        "offset": 4830,
        "speaker_id": 2,
        "text": "呂布算什麼？讓他看看我的厲害．"
      }
    ],
    "duel": {
      "pair": [
        "张飞",
        "吕布"
      ],
      "result": "吕布撤退，张飞直接升1级，战斗结束",
      "dialogue": [
        {
          "offset": 4865,
          "speaker_id": 2,
          "text": "對面可是呂布，來與我一決勝負！"
        },
        {
          "offset": 5064,
          "speaker_id": 4,
          "text": "還真有兩下子．"
        },
